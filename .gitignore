# ---- Build artifacts (regenerated by docker/container.sh + bootstrap_ws.sh) ----
docker/cache/

# ---- Upstream code cloned at runtime, not ours ----
# bootstrap_ws.sh clones doosan-robot2 (humble) into here on first container start.
third_party/doosan-robot2/
# Not used by current setup (we switched to the official m1013.usd shipped with
# doosan-robot2). Kept optional for future URDF/CuRobo experiments — clone it
# manually if you need it.
third_party/doosan-robot-isaac-driver/

# ---- Lab reference material (each site has its own copy) ----
reference/

# ---- Original lab tarball (one-off import) ----
doosan.tar.gz
doosan_docker_portable.tar.gz

# ---- Ephemeral logs ----
build_log
*.log
log/
.ros/

# ---- Python bytecode ----
__pycache__/
*.pyc
*.pyo

# ---- Editor / OS cruft ----
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- Experiment protocol (local documentation, not part of the project) ----
experiment_protocol.md

# ---- Claude Code local config (not part of the project) ----
.claude/
